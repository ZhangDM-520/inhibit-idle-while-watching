#!/usr/bin/env python3
"""face-watch - presence check + idle-inhibitor holder for inhibit-idle-while-watching.

One episode, driven by the Noctalia plugin service:

  face-watch episode --camera-path ... --detector haar ...   # the full loop
  face-watch check  --camera-path ...                        # one capture+detect
  face-watch autodetect                                      # print the camera device
  face-watch stop                                            # ask a running episode to stop

Contract (why this exists): Noctalia's idle chain is about to act (its idle
behaviour fired `idle-begin` at the plugin). We capture ONE frame, detect a
face, and while a face keeps appearing we HOLD both idle inhibitors:

  1. logind `Inhibit("idle")` via a `systemd-inhibit` child. Noctalia's idle
     behaviours consult logind's BlockInhibited (measured, niri+Noctalia host).
  2. niri's `org.freedesktop.ScreenSaver.Inhibit` on ONE persistent session-bus
     connection (a fresh connection per call yields invalid cookies on UnInhibit).

Releasing restarts the idle countdown from zero (smithay reinsert_timer,
measured), so with no face the normal dim/screen-off/lock chain proceeds
untouched. No face, any check error, lock, stop-file, or max_hold -> RELEASE.
Fail-open is deliberate: a broken camera must never pin the session awake.

Privacy: frames are decoded in RAM and dropped; nothing is written unless
--debug (then only a one-line verdict). The lock guard refuses to touch the
camera while the session is locked. The camera's own activity LED is the
user-visible signal and cannot be suppressed here.

Power: capture happens once per check (idle triggers + recheck_interval while
holding), never a continuous stream. The holder blocks on D-Bus and sleeps;
there is no polling loop outside the re-check cadence.

Modules dbus and cv2 are imported lazily so every pure function above the IO
layer is testable without them (tests/test_face_watch.py).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time

SCREENSAVER_NAME = "org.freedesktop.ScreenSaver"
SCREENSAVER_PATHS = ("/ScreenSaver", "/org/freedesktop/ScreenSaver")
WHO = "inhibit-idle-while-watching"

EXIT_FACE = 0
EXIT_NO_FACE = 1
EXIT_ERROR = 2
EXIT_SKIPPED = 3  # locked / disabled: not an error, not a verdict


# ── pure helpers (no IO) ─────────────────────────────────────────────────────

def parse_v4l2_devices(text: str) -> list[tuple[str, list[str]]]:
    """`v4l2-ctl --list-devices` output -> [(device_path, [all_paths])], in order.

    ASUS FHD webcam: ASUS FHD webca (usb-0000:c4:00.4-1):
            /dev/video0
            /dev/video1
    A blank line separates devices; continuation lines are the device nodes.
    """
    devices: list[tuple[str, list[str]]] = []
    name = None
    paths: list[str] = []
    for line in text.splitlines() + [""]:
        stripped = line.strip()
        if not stripped:
            if paths:
                devices.append((paths[0], list(paths)))
            name, paths = None, []
            continue
        if line.startswith("\t") or line.startswith(" "):
            if stripped.startswith("/dev/video"):
                paths.append(stripped)
        else:
            name = stripped.rstrip(":")
    return devices


def pick_camera(devices: list[tuple[str, list[str]]], capture_capable: dict[str, bool]) -> str | None:
    """Best capture node: webcam-named device first, then any capture-capable
    node, lowest /dev/videoN. capture_capable maps path -> supports video capture
    (from `v4l2-ctl --list-formats`; metadata nodes say otherwise)."""
    capable = [p for p, ok in capture_capable.items() if ok]
    if not capable:
        return None
    named = [(primary, paths) for primary, paths in devices
             if re.search(r"webcam|camera", primary + " " + " ".join(paths), re.I)]
    ordered: list[str] = []
    for primary, paths in (named or devices):
        ordered.extend(paths)
    for path in ordered:
        if path in capable:
            return path
    return sorted(capable)[0]


def score_threshold(sensitivity: int) -> float:
    """Sensitivity knob (1..10, 5 default) -> DNN score threshold.
    Stricter at higher sensitivity: 1 -> 0.35 ... 10 -> 0.90."""
    s = max(1, min(10, int(sensitivity)))
    return 0.30 + (s - 1) * 0.06


def haar_neighbors(sensitivity: int) -> int:
    """Sensitivity knob -> Haar minNeighbors (higher = stricter)."""
    return max(2, min(12, int(sensitivity)))


HAAR_CASCADE_FILE = "haarcascade_frontalface_default.xml"

# Distro OpenCV builds (Arch python-opencv) ship NO cv2.data — that attribute
# exists only in the pip wheels. Their Haar XMLs live under
# /usr/share/opencv*/haarcascades instead (measured 2026-10-22).
HAAR_CASCADE_DIRS = (
    "/usr/share/opencv5/haarcascades",
    "/usr/share/opencv4/haarcascades",
    "/usr/share/opencv/haarcascades",
)


def resolve_haar_cascade(dirs, exists=os.path.exists) -> str | None:
    """First existing <dir>/HAAR_CASCADE_FILE in candidate order, else None."""
    for d in dirs:
        candidate = os.path.join(d, HAAR_CASCADE_FILE)
        if exists(candidate):
            return candidate
    return None


def decide_episode(check_result: str, holding: bool, now: float, deadline: float) -> str:
    """One episode-loop decision: 'hold' (keep/enter inhibition), 'release'."""
    if check_result != "face":
        return "release"
    if now >= deadline:
        return "release"
    return "hold"


# ── camera / detect IO ───────────────────────────────────────────────────────

def autodetect_camera() -> str | None:
    try:
        listed = subprocess.run(["v4l2-ctl", "--list-devices"], capture_output=True,
                                text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    devices = parse_v4l2_devices(listed.stdout or "")
    capable: dict[str, bool] = {}
    for _primary, paths in devices:
        for path in paths:
            try:
                probe = subprocess.run(["v4l2-ctl", "-d", path, "--list-formats"],
                                       capture_output=True, text=True, timeout=5)
                capable[path] = "Capture" in (probe.stdout or "")
            except (OSError, subprocess.TimeoutExpired):
                capable[path] = False
    return pick_camera(devices, capable)


def capture_frame(camera: str, width: int) -> "object":
    """One frame from the camera as a cv2 BGR image, via ffmpeg -> stdout pipe.

    The frame never touches disk. MJPEG on the pipe keeps the transfer small;
    `height` follows a 4:3 sensor (this host's UVC camera)."""
    import cv2  # lazy: tests never import it

    height = max(1, width * 3 // 4)
    cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error",
           "-f", "v4l2", "-video_size", f"{width}x{height}",
           "-i", camera, "-frames:v", "1",
           "-f", "image2pipe", "-vcodec", "mjpeg", "-"]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=15)
    except subprocess.TimeoutExpired as err:
        raise RuntimeError(f"camera capture timed out on {camera}") from err
    if proc.returncode != 0 or not proc.stdout:
        tail = (proc.stderr or b"").decode("utf-8", "replace").strip()[-200:]
        raise RuntimeError(f"camera capture failed on {camera}: {tail}")
    img = cv2.imdecode(_buffer(proc.stdout), cv2.IMREAD_COLOR)
    if img is None:
        raise RuntimeError(f"captured frame from {camera} did not decode")
    return img


def _buffer(raw: bytes) -> "object":
    import numpy as np  # lazy

    return np.frombuffer(raw, dtype=np.uint8)


def detect_faces(img, detector: str, sensitivity: int) -> int:
    """Face count in a BGR frame under the chosen detector. Raises on bad config."""
    import cv2  # lazy

    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    # Detect on a small frame: Haar cost is superlinear and faces near the
    # camera dominate a 320px-wide image easily.
    small = cv2.resize(gray, (320, max(1, 320 * gray.shape[0] // gray.shape[1])))
    if detector == "haar":
        wheel_dir = getattr(getattr(cv2, "data", None), "haarcascades", None)
        dirs = ([wheel_dir] if wheel_dir else []) + list(HAAR_CASCADE_DIRS)
        path = resolve_haar_cascade(dirs)
        if path is None:
            raise RuntimeError("haar cascade data not found; tried: " + ", ".join(dirs))
        cascade = cv2.CascadeClassifier(path)
        if cascade.empty():
            raise RuntimeError("haar cascade failed to load")
        found = cascade.detectMultiScale(
            small, scaleFactor=1.1, minNeighbors=haar_neighbors(sensitivity),
            minSize=(24, 24))
        return len(found)
    if detector == "dnn":
        model = os.path.join(os.path.dirname(os.path.abspath(__file__)), "assets", "face-dnn.onnx")
        if not os.path.exists(model):
            raise RuntimeError("dnn detector selected but assets/face-dnn.onnx is missing")
        net = cv2.dnn.readNetFromONNX(model)
        blob = cv2.dnn.blobFromImage(cv2.resize(img, (320, 240)), 1.0 / 127.5,
                                     (320, 240), (127.5, 127.5, 127.5), swapRB=True)
        net.setInput(blob)
        scores, boxes = net.forward(["scores", "boxes"])
        threshold = score_threshold(sensitivity)
        count = 0
        for i in range(scores.shape[1] if scores.ndim > 1 else len(scores)):
            score = float(scores[0][i] if scores.ndim > 1 else scores[i])
            if score >= threshold:
                count += 1
        return count
    raise RuntimeError(f"unknown detector: {detector}")


# ── lock guard ───────────────────────────────────────────────────────────────

def session_locked() -> bool | None:
    """Locked state via `noctalia msg status`; None when unknown (caller decides)."""
    try:
        proc = subprocess.run(["noctalia", "msg", "status"], capture_output=True,
                              text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        return bool(json.loads(proc.stdout or "{}").get("locked"))
    except json.JSONDecodeError:
        return None


# ── status / log files ───────────────────────────────────────────────────────

def write_status(path: str | None, **fields) -> None:
    if not path:
        return
    fields.setdefault("updated_at", time.time())
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(fields, fh)
    os.replace(tmp, path)


def log_line(log_path: str | None, text: str) -> None:
    if not log_path:
        return
    with open(log_path, "a", encoding="utf-8") as fh:
        fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n")


# ── inhibitors ───────────────────────────────────────────────────────────────

class Inhibitors:
    """Both idle inhibitors on one persistent bus connection; kill-safe.

    logind: a `systemd-inhibit --what=idle ... sleep <seconds>` child. The lock
    lives exactly as long as the child; a crash or SIGKILL drops it with the
    child, so a dead plugin can never pin the session awake. The sleep duration
    is the remaining max-hold: a hung holder self-expires regardless.
    niri: org.freedesktop.ScreenSaver.Inhibit cookie, released on the SAME
    connection (fresh-connection-per-call = invalid cookie, measured).
    """

    def __init__(self, log_path: str | None = None):
        self.log_path = log_path
        self._proc: subprocess.Popen | None = None
        self._bus = None
        self._cookie = None

    @property
    def held(self) -> bool:
        return self._proc is not None or self._cookie is not None

    def acquire(self, remaining_s: float) -> None:
        if self._proc is None:
            budget = max(1, int(remaining_s) + 30)
            self._proc = subprocess.Popen(
                ["systemd-inhibit", "--what=idle", "--mode=block",
                 "--who=" + WHO, "--why=face detected", "sleep", str(budget)])
            log_line(self.log_path, "held logind idle inhibitor")
        if self._cookie is None:
            try:
                import dbus  # lazy

                if self._bus is None:
                    self._bus = dbus.SessionBus()
                for path in SCREENSAVER_PATHS:
                    try:
                        obj = self._bus.get_object(SCREENSAVER_NAME, path)
                        self._cookie = obj.Inhibit(WHO, "face detected")
                        log_line(self.log_path, f"held niri screensaver inhibitor ({path})")
                        break
                    except Exception:  # noqa: BLE001 - try the next path
                        continue
            except Exception as err:  # noqa: BLE001 - logind alone still works
                log_line(self.log_path, f"niri inhibitor unavailable: {err}")

    def release(self) -> None:
        if self._proc is not None:
            self._proc.terminate()
            try:
                self._proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self._proc.kill()
            self._proc = None
            log_line(self.log_path, "released logind idle inhibitor")
        if self._cookie is not None and self._bus is not None:
            try:
                obj = self._bus.get_object(SCREENSAVER_NAME, SCREENSAVER_PATHS[0])
                obj.UnInhibit(self._cookie)
                log_line(self.log_path, "released niri screensaver inhibitor")
            except Exception as err:  # noqa: BLE001 - connection death frees it
                log_line(self.log_path, f"niri release failed (connection death frees it): {err}")
            self._cookie = None


# ── commands ─────────────────────────────────────────────────────────────────

def resolve_camera(args) -> str:
    if getattr(args, "camera_path", ""):
        return args.camera_path
    found = autodetect_camera()
    if not found:
        raise RuntimeError("no capture-capable camera found (set camera_path)")
    return found


def run_check(args) -> tuple[int, str]:
    """One check -> (exit_code, verdict)."""
    locked = session_locked()
    if locked is True:
        return EXIT_SKIPPED, "locked"
    camera = resolve_camera(args)
    img = capture_frame(camera, args.capture_width)
    faces = detect_faces(img, args.detector, args.sensitivity)
    return (EXIT_FACE, f"face ({faces})") if faces > 0 else (EXIT_NO_FACE, "no_face")


def cmd_check(args) -> int:
    code, verdict = run_check(args)
    log_line(args.log_file, f"check camera=? detector={args.detector} -> {verdict}")
    print(verdict)
    return code


def cmd_autodetect(args) -> int:
    camera = autodetect_camera()
    if not camera:
        print("none", file=sys.stderr)
        return EXIT_ERROR
    print(camera)
    return 0


def cmd_stop(args) -> int:
    write_status(args.status_file, state="stopping") if args.status_file else None
    stop_path = args.stop_file or ((args.status_file or "") + ".stop")
    with open(stop_path, "w", encoding="utf-8") as fh:
        fh.write("stop\n")
    return 0


def cmd_episode(args) -> int:
    stop_path = args.stop_file or ((args.status_file or "") + ".stop")
    if os.path.exists(stop_path):
        os.remove(stop_path)
    inhibitors = Inhibitors(args.log_file)
    started = time.time()
    deadline = started + args.max_hold
    checks = 0
    result = "no_face"
    try:
        while True:
            if os.path.exists(stop_path):
                result = "stopped"
                break
            checks += 1
            try:
                code, verdict = run_check(args)
            except Exception as err:  # noqa: BLE001 - fail open
                log_line(args.log_file, f"check error: {err}")
                result = "error"
                break
            if code == EXIT_SKIPPED:
                result = "locked"
                break
            now = time.time()
            decision = decide_episode("face" if code == EXIT_FACE else "no_face",
                                      inhibitors.held, now, deadline)
            write_status(args.status_file, state="holding" if decision == "hold" else "releasing",
                         last_result=verdict, checks=checks, camera=args.camera_path or "auto",
                         detector=args.detector, held=inhibitors.held, since=started)
            if decision == "release":
                result = verdict
                break
            inhibitors.acquire(deadline - now)
            # interruptible re-check cadence (stop-file lands within one interval)
            for _ in range(int(args.recheck_interval)):
                if os.path.exists(stop_path):
                    break
                time.sleep(1)
    except Exception as err:  # noqa: BLE001 - never hold through a crash
        log_line(args.log_file, f"episode error: {err}")
        result = "error"
    finally:
        inhibitors.release()
        write_status(args.status_file, state="idle", last_result=result, checks=checks,
                     since=started, ended_at=time.time())
        log_line(args.log_file, f"episode end: {result} after {checks} check(s)")
    return EXIT_FACE if result.startswith("face") else EXIT_NO_FACE


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="face-watch")
    sub = parser.add_subparsers(dest="command", required=True)

    def common(p: argparse.ArgumentParser) -> None:
        p.add_argument("--camera-path", default="", help="v4l2 device; empty = autodetect")
        p.add_argument("--detector", choices=("haar", "dnn"), default="haar")
        p.add_argument("--sensitivity", type=int, default=5, help="1 loose .. 10 strict")
        p.add_argument("--capture-width", type=int, default=640)
        p.add_argument("--log-file", default=None)

    p_check = sub.add_parser("check")
    common(p_check)
    p_check.set_defaults(func=cmd_check)

    p_auto = sub.add_parser("autodetect")
    p_auto.set_defaults(func=cmd_autodetect)

    p_stop = sub.add_parser("stop")
    p_stop.add_argument("--status-file", default=None)
    p_stop.add_argument("--stop-file", default=None)
    p_stop.set_defaults(func=cmd_stop)

    p_ep = sub.add_parser("episode")
    common(p_ep)
    p_ep.add_argument("--recheck-interval", type=int, default=60)
    p_ep.add_argument("--max-hold", type=int, default=7200)
    p_ep.add_argument("--status-file", default=None)
    p_ep.add_argument("--stop-file", default=None)
    p_ep.set_defaults(func=cmd_episode)

    args = parser.parse_args(argv)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(EXIT_NO_FACE))
    try:
        return args.func(args)
    except Exception as err:  # noqa: BLE001 - CLI boundary
        print(f"face-watch: {err}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
